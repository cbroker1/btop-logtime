+	namespace {
+		//* Maps between graph columns and history age for the non-linear time axis (see Graph::_rebuild)
+		struct TimeAxis {
+			int slots;        //? Visible time slots, slot 0 is the newest (right edge)
+			double H;         //? Age in samples at the left edge
+			double k = 0;     //? Steepness of the curve, 0 = linear with 1 sample per slot
+
+			//? Exponential, with the steepness solved so that the newest slot spans about 1 sample and every older slot spans
+			//? more, until slot <slots> starts exactly H samples back. Falls back to 1 sample per slot when there are fewer
+			//? samples than slots and nothing to compress (or when the non-linear axis is off, H is then 2).
+			explicit TimeAxis(int slots) : slots(slots), H((double)std::max<size_t>(Config::hist_samples(), 2)) {
+				if (H / slots > 1.0) {
+					double lo = 0, hi = 60;
+					for (int it = 0; it < 60; it++) {
+						const double mid = (lo + hi) / 2;
+						const double first = H * std::expm1(mid / slots) / std::expm1(mid);
+						(first > 1.0 ? lo : hi) = mid;
+					}
+					k = (lo + hi) / 2;
+				}
+			}
+
+			//? Age in samples at which slot <q> starts
+			double age_at(int q) const {
+				return (k > 0) ? H * std::expm1(k * q / slots) / std::expm1(k) : (double)q;
+			}
+
+			//? Slot position (counted from the right edge) of an age in samples, the inverse of age_at()
+			double slot_at(double age) const {
+				return (k > 0) ? slots * std::log1p(age * std::expm1(k) / H) / k : age;
+			}
+
+			//? Age in samples at the left edge of the graph
+			double span() const { return (k > 0) ? H : (double)slots; }
+		};
+	}
