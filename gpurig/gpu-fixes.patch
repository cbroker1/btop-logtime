+#ifdef GPU_SUPPORT
+//* Keeps every detected GPU visible as cards change between boots: one box each when all of them fit the
+//* terminal (gpu0-gpu5), otherwise no gpu boxes, which makes the cpu box list every GPU (show_gpu_info "Auto")
+namespace GpuAuto {
+	bool active = false;	// set at startup when gpu_auto_boxes is on and the layout lists a gpu box
+	size_t slot = 0;		// how many non-gpu boxes came before the first gpu box
+	size_t placed = 0;		// gpu boxes set by the last fit
+	bool fitted = false;
+
+	//? shown_boxes split into its non-gpu boxes and how many gpu boxes it lists
+	auto split_boxes() {
+		vector<string> others;
+		size_t gpus_listed = 0;
+		for (const auto& box : ssplit(Config::getS("shown_boxes"))) {
+			if (box.starts_with("gpu")) ++gpus_listed;
+			else others.push_back(box);
+		}
+		return std::pair{others, gpus_listed};
+	}
+
+	string join(const vector<string>& others, size_t gpu_boxes) {
+		vector<string> list = others;
+		const auto at = list.begin() + std::min(slot, list.size());
+		vector<string> gpus;
+		for (size_t i = 0; i < gpu_boxes; i++) gpus.push_back("gpu" + to_string(i));
+		list.insert(at, gpus.begin(), gpus.end());
+		if (list.empty()) list = {"cpu", "mem", "net"};
+		string joined;
+		for (const auto& box : list) joined += (joined.empty() ? "" : " ") + box;
+		return joined;
+	}
+
+	//? Before the config is written: store the full layout instead of whatever fitted the last window size,
+	//? with at least gpu0 so auto mode still starts after a boot with no cards (gpu boxes are only checked against
+	//? detected GPUs after GpuAuto has rebuilt them)
+	void save_intent() {
+		if (not active) return;
+		const auto [others, gpus_listed] = split_boxes();
+		if (fitted and gpus_listed != placed) return;
+		Config::set("shown_boxes", join(others, std::clamp<size_t>(Gpu::gpu_names.size(), 1, 6)));
+	}
+
+	void fit() {
+		if (not active) return;
+		const auto [others, gpus_listed] = split_boxes();
+		//? A different gpu count than we placed means the user toggled boxes or picked a preset; stop overriding
+		if (fitted and gpus_listed != placed) { active = false; return; }
+
+		const size_t total = Gpu::gpu_names.size();
+		const auto join = [&](size_t gpu_boxes) { return GpuAuto::join(others, gpu_boxes); };
+
+		size_t gpu_boxes = 0;
+		if (total > 0 and total <= 6) {
+			const auto [w, h] = Term::get_min_size(join(total));
+			if (Term::width >= w and Term::height >= h) gpu_boxes = total;
+		}
+		const string result = join(gpu_boxes);
+		placed = gpu_boxes;
+		fitted = true;
+		if (result != Config::getS("shown_boxes")) {
+			Config::set("shown_boxes", result);
+			Config::check_boxes(result);
+		}
+	}
+}
+#endif
