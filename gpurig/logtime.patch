+	std::array<int, 3> query_bg(const int timeout_ms) {
+		const std::array<int, 3> none = {-1, -1, -1};
+		const char* term = std::getenv("TERM");
+		if (not initialized or term == nullptr or string(term) == "linux" or string(term) == "dumb") return none;
+
+		cout << "\x1b]11;?\x1b\\" << flush;
+		string reply;
+		const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeout_ms);
+		while (true) {
+			const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now()).count();
+			if (left <= 0) break;
+			pollfd pfd = {STDIN_FILENO, POLLIN, 0};
+			if (poll(&pfd, 1, (int)left) <= 0) break;
+			char buf[128];
+			const ssize_t n = read(STDIN_FILENO, buf, sizeof(buf));
+			if (n <= 0) break;
+			reply.append(buf, n);
+			if (reply.find('\a') != string::npos or reply.find("\x1b\\") != string::npos) break;
+		}
+
+		//? Reply looks like ESC ] 11 ; rgb:RRRR/GGGG/BBBB ST, with 1-4 hex digits per channel
+		const auto pos = reply.find("rgb:");
+		if (pos == string::npos) return none;
+		std::array<int, 3> rgb;
+		size_t p = pos + 4;
+		for (int c = 0; c < 3; c++) {
+			size_t e = p;
+			while (e < reply.size() and std::isxdigit((unsigned char)reply[e])) e++;
+			if (e == p or e - p > 4) return none;
+			const int digits = (int)(e - p);
+			rgb[c] = std::stoi(reply.substr(p, digits), nullptr, 16) * 255 / ((1 << (4 * digits)) - 1);
+			p = e + 1;
+		}
+		return rgb;
+	}
+
